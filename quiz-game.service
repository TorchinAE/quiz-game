[Unit]
Description=Quiz Game FastAPI application
After=network.target

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/root/quiz-game

Environment="PATH=/root/quiz-game/venv/bin"
EnvironmentFile=/root/quiz-game/.env

ExecStart=/root/quiz-game/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
